<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_md">

        <!-- Bottom Sheet Drag Handle -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="#FFE6E6E6"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvFormTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tambah Pengunjung"
            android:textSize="@dimen/text_subtitle"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="16dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilNomorKartu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_md"
            android:hint="@string/nomor_kartu"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            app:boxCornerRadiusTopStart="@dimen/button_radius"
            app:boxCornerRadiusTopEnd="@dimen/button_radius"
            app:boxCornerRadiusBottomStart="@dimen/button_radius"
            app:boxCornerRadiusBottomEnd="@dimen/button_radius">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etNomorKartu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilNamaSiswa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_md"
            android:hint="@string/nama_siswa"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            app:boxCornerRadiusTopStart="@dimen/button_radius"
            app:boxCornerRadiusTopEnd="@dimen/button_radius"
            app:boxCornerRadiusBottomStart="@dimen/button_radius"
            app:boxCornerRadiusBottomEnd="@dimen/button_radius">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etNamaSiswa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPersonName"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Tipe Pengunjung Selector -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilTipe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_md"
            android:hint="Tipe Pengunjung"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            app:boxCornerRadiusTopStart="@dimen/button_radius"
            app:boxCornerRadiusTopEnd="@dimen/button_radius"
            app:boxCornerRadiusBottomStart="@dimen/button_radius"
            app:boxCornerRadiusBottomEnd="@dimen/button_radius">

            <AutoCompleteTextView
                android:id="@+id/actvTipe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:text="Siswa" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Siswa Fields -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilKelas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_md"
            android:hint="Kelas"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            app:boxCornerRadiusTopStart="@dimen/button_radius"
            app:boxCornerRadiusTopEnd="@dimen/button_radius"
            app:boxCornerRadiusBottomStart="@dimen/button_radius"
            app:boxCornerRadiusBottomEnd="@dimen/button_radius">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etKelas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Umum Fields (Initially Gone) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilUsiaRange"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_md"
            android:hint="Kategori Usia"
            android:visibility="gone"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            app:boxCornerRadiusTopStart="@dimen/button_radius"
            app:boxCornerRadiusTopEnd="@dimen/button_radius"
            app:boxCornerRadiusBottomStart="@dimen/button_radius"
            app:boxCornerRadiusBottomEnd="@dimen/button_radius">

            <AutoCompleteTextView
                android:id="@+id/actvUsiaRange"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilAlamat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_md"
            android:hint="Alamat"
            android:visibility="gone"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            app:boxCornerRadiusTopStart="@dimen/button_radius"
            app:boxCornerRadiusTopEnd="@dimen/button_radius"
            app:boxCornerRadiusBottomStart="@dimen/button_radius"
            app:boxCornerRadiusBottomEnd="@dimen/button_radius">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etAlamat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:maxLines="3" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPekerjaan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_md"
            android:hint="Pekerjaan"
            android:visibility="gone"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            app:boxCornerRadiusTopStart="@dimen/button_radius"
            app:boxCornerRadiusTopEnd="@dimen/button_radius"
            app:boxCornerRadiusBottomStart="@dimen/button_radius"
            app:boxCornerRadiusBottomEnd="@dimen/button_radius">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPekerjaan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilInstansi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_md"
            android:hint="Instansi"
            android:visibility="gone"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            app:boxCornerRadiusTopStart="@dimen/button_radius"
            app:boxCornerRadiusTopEnd="@dimen/button_radius"
            app:boxCornerRadiusBottomStart="@dimen/button_radius"
            app:boxCornerRadiusBottomEnd="@dimen/button_radius">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etInstansi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Barcode Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/barcode"
            android:textSize="@dimen/text_subtitle"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="@dimen/spacing_sm" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="@dimen/spacing_sm">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilBarcode"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/spacing_sm"
                android:hint="@string/barcode_siswa"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                app:boxCornerRadiusTopStart="@dimen/button_radius"
                app:boxCornerRadiusTopEnd="@dimen/button_radius"
                app:boxCornerRadiusBottomStart="@dimen/button_radius"
                app:boxCornerRadiusBottomEnd="@dimen/button_radius">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etBarcode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <ImageButton
                android:id="@+id/btnScanBarcode"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center_vertical"
                android:src="@drawable/ic_qr_scan"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/scan_barcode"
                android:layout_marginEnd="@dimen/spacing_xs" />

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGenerateBarcode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/generate_barcode"
            android:textAllCaps="false"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            app:cornerRadius="@dimen/button_radius"
            app:strokeColor="@color/primary"
            app:icon="@drawable/ic_qr_scan"
            android:layout_marginBottom="@dimen/spacing_md" />

        <!-- Barcode Preview -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardBarcodePreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_lg"
            android:visibility="gone"
            app:cardCornerRadius="@dimen/card_radius"
            app:cardElevation="0dp"
            app:strokeColor="#FFE6E6E6"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Preview Barcode"
                    android:textSize="@dimen/text_caption"
                    android:textColor="@color/text_secondary"
                    android:layout_marginBottom="@dimen/spacing_sm" />

                <ImageView
                    android:id="@+id/ivBarcodePreview"
                    android:layout_width="@dimen/barcode_width"
                    android:layout_height="@dimen/barcode_height"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/tvBarcodeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_caption"
                    android:textColor="@color/text_primary"
                    android:layout_marginTop="@dimen/spacing_xs" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Save Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSimpan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/simpan"
            android:textAllCaps="false"
            app:cornerRadius="@dimen/button_radius" />

    </LinearLayout>
</ScrollView>
