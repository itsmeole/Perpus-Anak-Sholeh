<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_md">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Peminjaman Buku"
            android:textSize="@dimen/text_title"
            android:textStyle="bold"
            android:textColor="@color/primary_dark"
            android:layout_marginBottom="@dimen/spacing_md" />

        <!-- Step 1: Scan Siswa -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_md"
            app:cardCornerRadius="@dimen/card_radius"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1. Data Pengunjung"
                    android:textSize="@dimen/text_subtitle"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="@dimen/spacing_sm" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnScanSiswa"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Scan Barcode Pengunjung"
                    android:textAllCaps="false"
                    android:textColor="@color/primary_dark"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    app:icon="@drawable/ic_qr_scan"
                    app:iconTint="@color/primary_dark"
                    app:iconGravity="textStart"
                    app:cornerRadius="@dimen/button_radius"
                    app:strokeColor="@color/primary_dark"
                    android:layout_marginBottom="@dimen/spacing_sm" />

                <LinearLayout
                    android:id="@+id/layoutSiswaInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:background="@drawable/bg_card_rounded"
                    android:padding="@dimen/spacing_sm">

                    <TextView
                        android:id="@+id/tvSiswaName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/text_subtitle"
                        android:textStyle="bold"
                        android:textColor="@color/primary_dark" />

                    <TextView
                        android:id="@+id/tvSiswaKartu"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/text_caption"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Step 2: Scan Buku -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_md"
            app:cardCornerRadius="@dimen/card_radius"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2. Data Buku"
                    android:textSize="@dimen/text_subtitle"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="@dimen/spacing_sm" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnScanBuku"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Scan Barcode Buku"
                    android:textAllCaps="false"
                    android:textColor="@color/primary_dark"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    app:icon="@drawable/ic_qr_scan"
                    app:iconTint="@color/primary_dark"
                    app:iconGravity="textStart"
                    app:cornerRadius="@dimen/button_radius"
                    app:strokeColor="@color/primary_dark"
                    android:layout_marginBottom="@dimen/spacing_sm" />

                <LinearLayout
                    android:id="@+id/layoutBukuInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:background="@drawable/bg_card_rounded"
                    android:padding="@dimen/spacing_sm">

                    <TextView
                        android:id="@+id/tvBukuJudul"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/text_subtitle"
                        android:textStyle="bold"
                        android:textColor="@color/primary_dark" />

                    <TextView
                        android:id="@+id/tvBukuBarcode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/text_caption"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Step 3: Durasi -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_lg"
            app:cardCornerRadius="@dimen/card_radius"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3. Durasi Pinjam"
                    android:textSize="@dimen/text_subtitle"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="@dimen/spacing_sm" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilDurasi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/durasi_pinjam"
                    app:suffixText="hari"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    app:boxCornerRadiusTopStart="@dimen/button_radius"
                    app:boxCornerRadiusTopEnd="@dimen/button_radius"
                    app:boxCornerRadiusBottomStart="@dimen/button_radius"
                    app:boxCornerRadiusBottomEnd="@dimen/button_radius">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etDurasi"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:text="7"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Proses Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnProses"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Proses Peminjaman"
            android:textAllCaps="false"
            android:textColor="@color/text_on_primary"
            android:textSize="@dimen/text_subtitle"
            app:cornerRadius="@dimen/button_radius" />

    </LinearLayout>
</ScrollView>
