<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_md">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Perpus Anak Sholeh"
            android:textSize="@dimen/text_title"
            android:textStyle="bold"
            android:textColor="@color/primary_dark"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Selamat datang di Sistem Manajemen Perpustakaan"
            android:textSize="@dimen/text_caption"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="@dimen/spacing_md" />

        <!-- Stats Row 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="@dimen/spacing_sm">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/spacing_xs"
                app:cardCornerRadius="@dimen/card_radius"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/card_siswa_bg"
                xmlns:app="http://schemas.android.com/apk/res-auto">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_md">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_person"
                        app:tint="@color/card_siswa_text"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tvTotalSiswa"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="@dimen/text_dashboard_number"
                        android:textStyle="bold"
                        android:textColor="@color/card_siswa_text" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/total_siswa"
                        android:textSize="@dimen/text_caption"
                        android:textColor="@color/card_siswa_text" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/spacing_xs"
                app:cardCornerRadius="@dimen/card_radius"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/card_buku_bg"
                xmlns:app="http://schemas.android.com/apk/res-auto">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_md">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_book"
                        app:tint="@color/card_buku_text"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tvTotalBuku"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="@dimen/text_dashboard_number"
                        android:textStyle="bold"
                        android:textColor="@color/card_buku_text" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/total_buku"
                        android:textSize="@dimen/text_caption"
                        android:textColor="@color/card_buku_text" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Stats Row 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="@dimen/spacing_sm">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/spacing_xs"
                app:cardCornerRadius="@dimen/card_radius"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/card_eksemplar_bg"
                xmlns:app="http://schemas.android.com/apk/res-auto">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_md">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_copy"
                        app:tint="@color/card_eksemplar_text"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tvTotalEksemplar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="@dimen/text_dashboard_number"
                        android:textStyle="bold"
                        android:textColor="@color/card_eksemplar_text" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/total_eksemplar"
                        android:textSize="@dimen/text_caption"
                        android:textColor="@color/card_eksemplar_text" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/spacing_xs"
                app:cardCornerRadius="@dimen/card_radius"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/card_peminjaman_bg"
                xmlns:app="http://schemas.android.com/apk/res-auto">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_md">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_swap"
                        app:tint="@color/card_peminjaman_text"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tvPeminjamanAktif"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="@dimen/text_dashboard_number"
                        android:textStyle="bold"
                        android:textColor="@color/card_peminjaman_text" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/peminjaman_aktif"
                        android:textSize="@dimen/text_caption"
                        android:textColor="@color/card_peminjaman_text" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Terlambat Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_md"
            app:cardCornerRadius="@dimen/card_radius"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/card_terlambat_bg"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="@dimen/spacing_md"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_warning"
                    app:tint="@color/card_terlambat_text"
                    android:layout_marginEnd="@dimen/spacing_md" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/buku_terlambat"
                        android:textSize="@dimen/text_subtitle"
                        android:textColor="@color/card_terlambat_text"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Buku yang belum dikembalikan"
                        android:textSize="@dimen/text_caption"
                        android:textColor="@color/card_terlambat_text" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvTerlambat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="@dimen/text_dashboard_number"
                    android:textStyle="bold"
                    android:textColor="@color/card_terlambat_text" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Quick Actions -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Aksi Cepat"
            android:textSize="@dimen/text_subtitle"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="@dimen/spacing_sm" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="@dimen/spacing_md">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPinjamBuku"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/spacing_xs"
                android:text="Pinjam Buku"
                android:textAllCaps="false"
                android:textColor="@color/text_on_primary"
                app:icon="@drawable/ic_book"
                app:iconTint="@color/text_on_primary"
                app:iconGravity="textStart"
                app:cornerRadius="@dimen/button_radius"
                xmlns:app="http://schemas.android.com/apk/res-auto" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnKembalikanBuku"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/spacing_xs"
                android:text="Kembalikan"
                android:textAllCaps="false"
                android:textColor="@color/primary_dark"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:icon="@drawable/ic_arrow_back"
                app:iconTint="@color/primary_dark"
                app:iconGravity="textStart"
                app:cornerRadius="@dimen/button_radius"
                app:strokeColor="@color/primary_dark"
                xmlns:app="http://schemas.android.com/apk/res-auto" />
        </LinearLayout>

        <!-- Backup & Pemulihan -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Backup &amp; Pemulihan"
            android:textSize="@dimen/text_subtitle"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="@dimen/spacing_sm" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="@dimen/spacing_md">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExportData"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/spacing_xs"
                android:text="Ekspor Data"
                android:textAllCaps="false"
                android:textColor="@color/primary_dark"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:icon="@drawable/ic_export"
                app:iconTint="@color/primary_dark"
                app:iconGravity="textStart"
                app:strokeColor="@color/primary_dark"
                app:cornerRadius="@dimen/button_radius"
                xmlns:app="http://schemas.android.com/apk/res-auto" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnImportData"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/spacing_xs"
                android:text="Impor Data"
                android:textAllCaps="false"
                android:textColor="@color/secondary_dark"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:icon="@drawable/ic_import"
                app:iconTint="@color/secondary_dark"
                app:iconGravity="textStart"
                app:strokeColor="@color/secondary_dark"
                app:cornerRadius="@dimen/button_radius"
                xmlns:app="http://schemas.android.com/apk/res-auto" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
