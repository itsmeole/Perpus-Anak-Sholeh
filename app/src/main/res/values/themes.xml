<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. Diubah dari DayNight ke Light -->
    <style name="Base.Theme.PerpusAnakSholeh" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_variant</item>
        <item name="colorOnPrimary">@color/text_on_primary</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryVariant">@color/secondary_dark</item>
        <item name="colorOnSecondary">@color/text_primary</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="materialCardViewStyle">@style/Widget.PerpusAnakSholeh.CardView</item>
        
        <!-- Font Family -->
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="fontFamily">@font/plus_jakarta_sans</item>
    </style>

    <style name="Theme.PerpusAnakSholeh" parent="Base.Theme.PerpusAnakSholeh" />

    <!-- Theme untuk Splash Screen -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/white</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="windowSplashScreenAnimationDuration">1000</item>
        <item name="postSplashScreenTheme">@style/Theme.PerpusAnakSholeh</item>
    </style>

    <!-- Card Style -->
    <style name="Widget.PerpusAnakSholeh.CardView" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">@dimen/card_radius</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/card_background</item>
        <item name="strokeColor">#FFE6E6E6</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Dashboard Card Style -->
    <style name="Widget.PerpusAnakSholeh.DashboardCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">@dimen/card_radius</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">#FFE6E6E6</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Button Styles -->
    <style name="Widget.PerpusAnakSholeh.Button" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">@dimen/button_radius</item>
    </style>

    <style name="Widget.PerpusAnakSholeh.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">@dimen/button_radius</item>
        <item name="strokeColor">@color/primary</item>
    </style>

    <!-- TextInput Style -->
    <style name="Widget.PerpusAnakSholeh.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/button_radius</item>
        <item name="boxCornerRadiusTopEnd">@dimen/button_radius</item>
        <item name="boxCornerRadiusBottomStart">@dimen/button_radius</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/button_radius</item>
    </style>
</resources>